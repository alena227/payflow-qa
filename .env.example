# Скопируй в .env:  copy .env.example .env
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow
JWT_SECRET=dev-secret-change-me
# 1 — включить скрытые баги
BUGS=0
# Бот поддержки: без ключа работает детерминированная заглушка (на ней идут тесты).
# Задай ключ, чтобы включить реальный облачный LLM (OpenAI-совместимый API).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
