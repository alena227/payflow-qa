{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payflow/transaction_event",
  "title": "transfer.completed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "event_type", "occurred_at", "tx_id",
    "from_account_id", "to_account_id", "from_user_id", "to_user_id",
    "amount", "currency", "fee", "amount_to", "currency_to", "rate"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "transfer.completed" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tx_id": { "type": "string", "format": "uuid" },
    "from_account_id": { "type": "integer", "minimum": 1 },
    "to_account_id": { "type": "integer", "minimum": 1 },
    "from_user_id": { "type": "integer", "minimum": 1 },
    "to_user_id": { "type": "integer", "minimum": 1 },
    "amount": { "$ref": "#/$defs/money" },
    "currency": { "$ref": "#/$defs/currency" },
    "fee": { "$ref": "#/$defs/money" },
    "amount_to": { "$ref": "#/$defs/money" },
    "currency_to": { "$ref": "#/$defs/currency" },
    "rate": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }
      ]
    }
  },
  "$defs": {
    "money": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "currency": { "enum": ["RUB", "USD"] }
  }
}
